#!/usr/bin/env bash
# Managed by Ansible — jyok1m.backups.mongo_restore ({{ mongo_restore_name }})
#
# Usage:
#   sudo mongo-restore-{{ mongo_restore_name }}.sh <snapshot-id|latest> [--drop] [--yes]
#
# Loads /etc/mongo-restore-{{ mongo_restore_name }}.env, resolves the requested
# snapshot, materializes the archive locally, and pipes it into mongorestore
# against the target container Mongo. Pass --yes to skip the confirmation
# prompt (e.g. for automated restore tests).
set -euo pipefail

NAME="{{ mongo_restore_name }}"
LOCAL_DIR="{{ mongo_restore_local_dir }}"
CONTAINER="{{ mongo_restore_container }}"
NETWORK="{{ mongo_restore_network }}"
IMAGE="{{ mongo_restore_image }}"
PORT="{{ mongo_restore_port }}"
AUTHDB="{{ mongo_restore_authdb }}"
DB="{{ mongo_restore_db }}"

ENV_FILE="/etc/mongo-restore-${NAME}.env"
if [[ ! -r "${ENV_FILE}" ]]; then
  echo "[${NAME}] env file ${ENV_FILE} is not readable" >&2
  exit 1
fi
set -a
# shellcheck disable=SC1090
source "${ENV_FILE}"
set +a

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <snapshot-id|latest> [--drop] [--yes]" >&2
  exit 64
fi
SNAP="$1"
shift

DROP="false"
ASSUME_YES="false"
for arg in "$@"; do
  case "${arg}" in
    --drop) DROP="true" ;;
    --yes|-y) ASSUME_YES="true" ;;
    *) echo "Unknown argument: ${arg}" >&2; exit 64 ;;
  esac
done

mkdir -p "${LOCAL_DIR}"
chmod 0700 "${LOCAL_DIR}"

TS="$(date -u +%Y%m%dT%H%M%SZ)"
WORKDIR="${LOCAL_DIR}/${TS}-${SNAP}"
mkdir -p "${WORKDIR}"

echo "[${NAME}] resolving snapshot ${SNAP}"
restic snapshots --tag "${NAME}" --json "${SNAP}" >/dev/null

echo "[${NAME}] restoring snapshot ${SNAP} → ${WORKDIR}"
restic restore "${SNAP}" --target "${WORKDIR}" --tag "${NAME}"

ARCHIVE="$(find "${WORKDIR}" -type f -name "${NAME}-*.archive.gz" | head -n 1)"
if [[ -z "${ARCHIVE}" ]]; then
  echo "[${NAME}] no archive found in ${WORKDIR}" >&2
  exit 2
fi

RESTORE_ARGS=(
  --host "${CONTAINER}:${PORT}"
  --username "${MONGO_RESTORE_USERNAME}"
  --password "${MONGO_RESTORE_PASSWORD}"
  --authenticationDatabase "${AUTHDB}"
  --archive
  --gzip
)
if [[ -n "${DB}" ]]; then
  RESTORE_ARGS+=(--nsInclude "${DB}.*")
fi
if [[ "${DROP}" == "true" ]]; then
  RESTORE_ARGS+=(--drop)
fi

if [[ "${ASSUME_YES}" != "true" ]]; then
  read -r -p "[${NAME}] About to mongorestore from ${ARCHIVE} into ${CONTAINER} (drop=${DROP}). Continue? [y/N] " ans
  if [[ "${ans}" != "y" && "${ans}" != "Y" ]]; then
    echo "[${NAME}] aborted" >&2
    exit 1
  fi
fi

echo "[${NAME}] mongorestore"
docker run --rm -i \
  --network "${NETWORK}" \
  -e MONGO_RESTORE_USERNAME \
  -e MONGO_RESTORE_PASSWORD \
  "${IMAGE}" \
  mongorestore "${RESTORE_ARGS[@]}" < "${ARCHIVE}"

echo "[${NAME}] cleanup ${WORKDIR}"
rm -rf "${WORKDIR}"

echo "[${NAME}] done"
