---
extends: default

yaml-files:
  - "*.yml"
  - "*.yaml"
  - ".yamllint"

ignore: |
  group_vars/infra/vault.yml
  host_vars/main-host/vault.yml
  **/*.tar.gz
  .cache/
  .pre-commit-cache/

rules:
  line-length:
    max: 160
    level: warning
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  document-start:
    present: true
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
