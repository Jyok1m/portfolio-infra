services:
  jenkins-dind:
    image: docker:dind
    container_name: jenkins-dind
    restart: unless-stopped
    privileged: true
    deploy:
      resources:
        limits:
          memory: 4G
          cpus: 4.0
        reservations:
          memory: 512M
    healthcheck:                                                                                                                           
      test: ["CMD", "docker", "info"]                                                                                                    
      interval: 10s                                                                                                                        
      timeout: 5s                                                                                                                          
      retries: 5                                                                                                                         
      start_period: 30s
    command: --storage-driver overlay2
    environment:
      - DOCKER_TLS_CERTDIR=/certs
    volumes:
      - jenkins:/var/jenkins_home
      - jenkins-docker-certs:/certs/client
      - jenkins-dind-data:/var/lib/docker
    networks:
      jenkins-internal:
        aliases:
          - docker

  jenkins-gui:
    image: {{ jenkins_image }}
    container_name: jenkins-gui
    restart: unless-stopped
    depends_on:                                                                                                                            
      jenkins-dind:
        condition: service_healthy
    deploy:
      resources:
        limits:
          memory: 2G
          cpus: 2.0
        reservations:
          memory: 512M
    environment:
      DOCKER_HOST: tcp://docker:2376
      DOCKER_CERT_PATH: /certs/client
      DOCKER_TLS_VERIFY: 1
      JENKINS_OPTS: --httpPort=8080
      JENKINS_URL: https://jenkins.{{ portfolio_domain_com }}/
      JAVA_OPTS: -Djenkins.model.Jenkins.crumbIssuerProxyCompatibility=true -Dhudson.security.csrf.DefaultCrumbIssuer.EXCLUDE_SESSION_ID=true
    volumes:
      - jenkins:/var/jenkins_home
      - jenkins-docker-certs:/certs/client:ro
    networks:
      - jenkins-internal
      - traefik-public
    labels:
      - traefik.enable=true
      # Principal
      - traefik.http.routers.jenkins.rule=Host(`jenkins.{{ portfolio_domain_com }}`)
      - traefik.http.routers.jenkins.entrypoints=websecure
      - traefik.http.routers.jenkins.tls.certresolver=letsencrypt
      - traefik.http.services.jenkins.loadbalancer.server.port=8080
      # Redirect from .fr to .com
      - traefik.http.routers.jenkins-redirect.rule=Host(`jenkins.{{ portfolio_domain_fr }}`)                                                                                                                             
      - traefik.http.routers.jenkins-redirect.entrypoints=websecure                                                                                                                                                             
      - traefik.http.routers.jenkins-redirect.tls.certresolver=letsencrypt                                                                                                                                                      
      - traefik.http.routers.jenkins-redirect.service=jenkins                                                                                                                                                                
      - traefik.http.routers.jenkins-redirect.middlewares=jenkins-redirect
      # Middleware to perform the redirection
      - traefik.http.middlewares.jenkins-redirect.redirectregex.regex=^https?://jenkins\.{{ portfolio_domain_fr | replace('.', '\\.') }}/(.*)                                                                            
      - traefik.http.middlewares.jenkins-redirect.redirectregex.replacement=https://jenkins.{{ portfolio_domain_com }}/$${1}                                                                                             
      - traefik.http.middlewares.jenkins-redirect.redirectregex.permanent=true

volumes:
  jenkins:
    name: jenkins
  jenkins-docker-certs:
    name: jenkins-docker-certs
  jenkins-dind-data:
    name: jenkins-dind-data

networks:
  jenkins-internal:                                                                                                                    
    name: jenkins-internal                                                                                                           
  traefik-public:
    name: traefik-public
    external: true