---
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    host: {{ inventory_hostname }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node-exporter
    static_configs:
      - targets: ["node-exporter:9100"]

  - job_name: cadvisor
    static_configs:
      - targets: ["cadvisor:8080"]

{% if 'edge' in group_names %}
  - job_name: traefik
    static_configs:
      - targets: ["traefik:8082"]

{% endif %}
{% if monitoring_is_hub %}
  - job_name: grafana
    metrics_path: /metrics
    static_configs:
      - targets: ["grafana:3000"]

{% for leaf in groups['all'] | difference(groups['infra'] | default([])) %}
  - job_name: federate-{{ leaf }}
    honor_labels: true
    metrics_path: /federate
    params:
      'match[]':
        - '{job!=""}'
    static_configs:
      - targets:
          - "{{ hostvars[leaf].vrack_ip }}:{{ monitoring_federation_port }}"
{% endfor %}
{% endif %}
