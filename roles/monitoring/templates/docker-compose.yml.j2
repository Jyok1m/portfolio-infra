services:
  prometheus:
    image: {{ prometheus_image }}
    container_name: prometheus
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: 2.0
          memory: 2G
        reservations:
          memory: 512M
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:9090/-/ready"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 30s
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --web.console.libraries=/etc/prometheus/console_libraries
      - --web.console.templates=/etc/prometheus/consoles
      - --storage.tsdb.retention.time=720h
      - --web.enable-lifecycle
{% if monitoring_is_hub %}
      - --web.external-url=https://prometheus.{{ portfolio_domain_com }}
{% endif %}
    volumes:
      - prometheus:/prometheus
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
{% if not monitoring_is_hub %}
    ports:
      - "{{ vrack_ip }}:{{ monitoring_federation_port }}:9090"
{% endif %}
    networks:
      - monitoring-internal
{% if 'edge' in group_names %}
      - traefik-public
{% endif %}
{% if monitoring_is_hub %}
    labels:
      - traefik.enable=true                                                                                                                                                                                                    
      # Main router (.com) — auth + real backend
      - traefik.http.routers.prom.rule=Host(`prometheus.{{ portfolio_domain_com }}`)                                                                                                                                           
      - traefik.http.routers.prom.entrypoints=websecure                                                                                                                                                                        
      - traefik.http.routers.prom.tls.certresolver=letsencrypt
      - traefik.http.routers.prom.service=prom                                                                                                                                                                                 
      - traefik.http.routers.prom.middlewares=prom-auth                                                                                                                                                                      
      - traefik.http.services.prom.loadbalancer.server.port=9090                                                                                                                                                               
      # Redirect router (.fr → .com)                                                                                                                                                                                         
      - traefik.http.routers.prom-fr.rule=Host(`prometheus.{{ portfolio_domain_fr }}`)                                                                                                                                         
      - traefik.http.routers.prom-fr.entrypoints=websecure                                                                                                                                                                     
      - traefik.http.routers.prom-fr.tls.certresolver=letsencrypt
      - traefik.http.routers.prom-fr.service=prom                                                                                                                                                                              
      - traefik.http.routers.prom-fr.middlewares=prom-redirect                                                                                                                                                               
      # Middlewares                                                                                                                                                                                                            
      - traefik.http.middlewares.prom-redirect.redirectregex.regex=^https?://prometheus\.{{ portfolio_domain_fr | replace('.', '\\.') }}/(.*)                                                                                
      - traefik.http.middlewares.prom-redirect.redirectregex.replacement=https://prometheus.{{ portfolio_domain_com }}/$${1}                                                                                                   
      - traefik.http.middlewares.prom-redirect.redirectregex.permanent=true                                                                                                                                                    
      # htpasswd -nbB admin 'password'                                                                                                                                                                                         
      - traefik.http.middlewares.prom-auth.basicauth.users={{ vault_prometheus_basic_auth | replace('$', '$$') }}   

  grafana:
    image: {{ grafana_image }}
    container_name: grafana
    restart: unless-stopped
    depends_on:
      prometheus:
        condition: service_healthy
    deploy:
      resources:
        limits:
          cpus: 1.0
          memory: 512M
        reservations:
          memory: 128M
    environment:
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_SERVER_ROOT_URL=https://grafana.{{ portfolio_domain_com }}
      - GF_SERVER_SERVE_FROM_SUB_PATH=true
      - GF_METRICS_ENABLED=true
    volumes:
      - grafana:/var/lib/grafana
      - "{{ app_path }}/grafana/provisioning:/etc/grafana/provisioning:ro"
    networks:
      - monitoring-internal
      - traefik-public
    labels:                                                                                                                                                                                                                  
      - traefik.enable=true
      # Main router (.com)
      - traefik.http.routers.grafana.rule=Host(`grafana.{{ portfolio_domain_com }}`)
      - traefik.http.routers.grafana.entrypoints=websecure                                                                                                                                                                     
      - traefik.http.routers.grafana.tls.certresolver=letsencrypt
      - traefik.http.routers.grafana.service=grafana                                                                                                                                                                           
      - traefik.http.services.grafana.loadbalancer.server.port=3000                                                                                                                                                          
      # Redirect router (.fr → .com)                                                                                                                                                                                           
      - traefik.http.routers.grafana-fr.rule=Host(`grafana.{{ portfolio_domain_fr }}`)                                                                                                                                       
      - traefik.http.routers.grafana-fr.entrypoints=websecure                                                                                                                                                                  
      - traefik.http.routers.grafana-fr.tls.certresolver=letsencrypt                                                                                                                                                           
      - traefik.http.routers.grafana-fr.service=grafana
      - traefik.http.routers.grafana-fr.middlewares=grafana-redirect                                                                                                                                                           
      # Middleware                                                                                                                                                                                                           
      - traefik.http.middlewares.grafana-redirect.redirectregex.regex=^https?://grafana\.{{ portfolio_domain_fr | replace('.', '\\.') }}/(.*)                                                                                  
      - traefik.http.middlewares.grafana-redirect.redirectregex.replacement=https://grafana.{{ portfolio_domain_com }}/$${1}                                                                                                   
      - traefik.http.middlewares.grafana-redirect.redirectregex.permanent=true    
{% endif %}

  node-exporter:
    image: {{ node_exporter_image }}
    container_name: node-exporter
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: 0.25
          memory: 128M
        reservations:
          memory: 32M
    command:
      - --path.procfs=/host/proc
      - --path.rootfs=/rootfs
      - --path.sysfs=/host/sys
      - --collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    networks:
      - monitoring-internal

  cadvisor:
    image: {{ cadvisor_image }}
    container_name: cadvisor
    restart: unless-stopped
    privileged: true
    deploy:
      resources:
        limits:
          cpus: 0.5
          memory: 256M
        reservations:
          memory: 64M
    devices:
      - /dev/kmsg:/dev/kmsg
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    networks:
      - monitoring-internal

volumes:
  prometheus:
    name: prometheus
{% if monitoring_is_hub %}
  grafana:
    name: grafana
{% endif %}

networks:
  monitoring-internal:
    name: monitoring-internal
{% if 'edge' in group_names %}
  traefik-public:
    name: traefik-public
    external: true
{% endif %}
